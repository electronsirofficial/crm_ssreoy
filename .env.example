# --- Database (Neon) ---------------------------------------------------------
# Neon dashboard → your project → Connect. Use the POOLED string (host contains "-pooler") for
# DATABASE_URL and the DIRECT string ("Connection pooling" toggle off) for DIRECT_URL (used by migrations).
# connect_timeout gives Neon time to wake a suspended compute. If you ever see
# 'prepared statement "s0" already exists', append &pgbouncer=true to DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Auth --------------------------------------------------------------------
# Any random string of 32+ characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- AI call analysis (Claude) -------------------------------------------------
ANTHROPIC_API_KEY=""
# CLAUDE_MODEL="claude-opus-5-5"

# --- Speech-to-text for call recordings ---------------------------------------
# deepgram | openai | none   (none = paste transcripts manually)
TRANSCRIPTION_PROVIDER="none"
DEEPGRAM_API_KEY=""
# DEEPGRAM_MODEL="nova-3"
# DEEPGRAM_LANGUAGE="multi"     # handles Hindi/English code-switching
OPENAI_API_KEY=""
# OPENAI_TRANSCRIBE_MODEL="whisper-1"

# --- Misc ----------------------------------------------------------------------
# Where uploaded photos/recordings are stored (local disk; use object storage in production)
STORAGE_DIR="storage"
# Shared secret for the scheduled sweep endpoint: GET /api/cron/sweep with header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Seed
SEED_ADMIN_EMAIL="admin@institute.test"
SEED_ADMIN_PASSWORD="Admin@12345"
# SEED_DEMO=false   # set to skip demo agents/leads
